	<!-- Buscar un emoji -->
	<string name="braille_busqueda_abierta">Buscar un emoji: escribe en braille palabras de su nombre. Un dedo a los lados recorre lo encontrado; dos dedos hacia abajo lo escriben; dos a la derecha, favorito; tres a la derecha, guardarlo en una categoría; dos a la izquierda borran una letra; un dedo hacia abajo separa palabras; dos hacia arriba, salir.</string>
	<string name="braille_busqueda_sin">Ningún emoji con «%1$s»</string>
	<plurals name="braille_busqueda_hay">
		<item quantity="one">Un emoji: %2$s</item>
		<item quantity="other">%1$d emojis. El primero: %2$s</item>
	</plurals>
	<plurals name="braille_busqueda_estado">
		<item quantity="one">Buscas «%1$s»: un emoji</item>
		<item quantity="other">Buscas «%1$s»: %2$d emojis</item>
	</plurals>
	<string name="braille_busqueda_escribe">Escribe primero una letra del nombre del emoji</string>
	<string name="braille_busqueda_ayuda">Un dedo a los lados, recorrer; dos dedos hacia abajo, escribir; dos a la derecha, favorito; tres a la derecha, a una categoría; dos a la izquierda, borrar una letra; un dedo hacia abajo, otra palabra; un dedo hacia arriba, lo que buscas; dos hacia arriba, salir</string>
	<string name="braille_busqueda_cerrada">Búsqueda de emojis cerrada</string>
