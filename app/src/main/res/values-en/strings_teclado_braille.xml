		<item quantity="other">%1$d emoji. The first one: %2$s</item>
	</plurals>
	<plurals name="braille_busqueda_estado">
		<item quantity="one">Searching «%1$s»: one emoji</item>
		<item quantity="other">Searching «%1$s»: %2$d emoji</item>
	</plurals>
