	<!-- Emoji search -->
	<string name="braille_busqueda_abierta">Search for an emoji: type words of its name in braille. One finger sideways goes through the results; two fingers down type it; two right, favourite; three right, save it in a category; two left delete a letter; one finger down separates words; two up, leave.</string>
	<string name="braille_busqueda_sin">No emoji with «%1$s»</string>
	<plurals name="braille_busqueda_hay">
